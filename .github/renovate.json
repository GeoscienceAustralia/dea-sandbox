{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Renovate config for dea-sandbox. Scans intent files only (requirements.txt, env.yaml, Dockerfile). Lock files in docker/locks/ are auto-generated by CI and excluded.",

  "extends": ["config:recommended"],

  "dependencyDashboard": true,
  "dependencyDashboardTitle": "Dependency Dashboard — dea-sandbox",
  "dependencyDashboardHeader": "This dashboard tracks all pending dependency updates.",

  "schedule": ["* 22 * * 0"],
  "timezone": "Australia/Sydney",
  "assignees": [],
  "reviewers": [],
  "labels": ["dependencies"],
  "prConcurrentLimit": 10,
  "prHourlyLimit": 0,
  "rebaseWhen": "conflicted",

  "ignoreDeps": ["fractional_cover", "python"],

  "vulnerabilityAlerts": {
    "enabled": false
  },

  "packageRules": [
    {
      "description": "Group all conda/pip dependency updates into a single PR to reduce noise",
      "matchManagers": ["pip_requirements", "pip-compile", "conda"],
      "groupName": "python dependencies",
      "groupSlug": "python-deps"
    },
    {
      "description": "Group GitHub Actions updates separately",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions",
      "groupSlug": "github-actions"
    },
    {
      "description": "Group Dockerfile base image updates",
      "matchManagers": ["dockerfile"],
      "groupName": "Docker base images",
      "groupSlug": "docker-base"
    },
    {
      "description": "Allow only minor/patch auto-merge for GitHub Actions — major requires review",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": false
    },
    {
      "description": "Exclude auto-generated lock files from direct Renovate management",
      "matchFileNames": [
        "docker/locks/pip-constraints.txt",
        "docker/locks/conda-linux-64.lock"
      ],
      "enabled": false
    }
  ],

  "customManagers": [
    {
      "description": "Pip intent file — direct dependencies only, unpinned",
      "customType": "regex",
      "managerFilePatterns": ["/^docker/requirements\\.txt$/"],
      "matchStrings": [
        "(?<depName>[a-zA-Z0-9_.-]+)(?<currentValue>[>=<!~^][^\\s#\\n]+)?"
      ],
      "datasourceTemplate": "pypi"
    },
    {
      "description": "conda env.yaml — scans conda-forge packages via Anaconda API",
      "customType": "regex",
      "managerFilePatterns": ["/^docker/env\\.yaml$/"],
      "matchStrings": [
        "- (?<depName>[a-zA-Z0-9_.-]+)(?:(?:=|>=|<=|~=)(?<currentValue>[^\\s#\\n]+))?"
      ],
      "datasourceTemplate": "conda",
      "packageNameTemplate": "conda-forge/{{depName}}"
    }
  ],

  "pip_requirements": {
    "managerFilePatterns": ["/^docker/requirements\\.txt$/"]
  },

  "dockerfile": {
    "managerFilePatterns": ["/^docker/Dockerfile$/"]
  },

  "github-actions": {
    "managerFilePatterns": [
      "/^\\.github/workflows/[^/]+\\.ya?ml$/",
      "/^\\.github/actions/[^/]+/action\\.ya?ml$/"
    ]
  },

  "ignorePaths": [
    "docker/locks/**",
    "integration-testing/**",
    "nci_environment/**"
  ]
}
